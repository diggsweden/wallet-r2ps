KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=r2ps-rest-api-group
KAFKA_BROKER_ADDRESS_FAMILY=v4
# Number of consumer tasks per response topic (default 1). Scales up to topic partition count.
#KAFKA_CONSUMER_THREADS_RESPONSE=1
#KAFKA_CONSUMER_THREADS_STATE_INIT_RESPONSE=1
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=secret
REDIS_DATABASE=0
SERVER_HOST=0.0.0.0
SERVER_PORT=8088
SERVE_SYNC=true
SYNC_TIMEOUT_MS=3000
RESPONSE_TTL_SECONDS=600
RESPONSE_EVENTS_TEMPLATE_URL=http://localhost:8088/hsm/v1/requests/%s
