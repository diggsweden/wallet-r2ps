FROM rust:1.96-bookworm@sha256:19817ead3289c8c631c73df281e18b59b172f6a31f4f563290f69cddd06c30e9 AS builder

RUN apt-get update && apt-get install -y \
    cmake \
    libssl-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY hsm-common ./hsm-common
COPY hsm-worker ./hsm-worker
COPY wallet-bff ./wallet-bff
COPY integration-load-tests ./integration-load-tests

RUN cargo build --release -p integration-load-tests

# Lets reusable-ci's extract.binary export the built binary.
FROM scratch AS export-binary
COPY --from=builder /app/target/release/integration-load-tests /integration-load-tests

FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241 AS runtime

RUN apt-get update && apt-get install -y \
    libssl3 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m appuser

# Place the binary in /usr/local/bin so both `docker run <image>` (via
# ENTRYPOINT) and `docker run <image> bash -c "integration-load-tests ..."`
# (used by the wallet-test cluster load-test Job, which overrides the
# container command) resolve it the same way.
COPY --from=builder /app/target/release/integration-load-tests /usr/local/bin/integration-load-tests

USER appuser

ENTRYPOINT ["integration-load-tests"]
