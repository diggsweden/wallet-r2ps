{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>diggsweden/.github:renovate-base",
    ":maintainLockFilesWeekly"
  ],
  "enabledManagers": ["github-actions", "cargo", "dockerfile"],
  "packageRules": [
    {
      "description": "Rust dependencies - Major updates",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["major"],
      "addLabels": ["rust", "dependencies", "major-update"]
    },
    {
      "description": "Rust dependencies - Non-major updates",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "addLabels": ["rust", "dependencies"],
      "groupName": "rust non-major"
    },
    {
      "description": "Block rand 0.9+ due to rand_core version conflict with p256/elliptic-curve",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["rand"],
      "allowedVersions": "<0.9.0"
    },
    {
      "description": "Docker base images",
      "matchManagers": ["dockerfile"],
      "addLabels": ["docker", "infrastructure"]
    }
  ]
}
